generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  PARENT
}

enum ContentType {
  PYQ
  NOTE
}

enum ExamType {
  FULL_MOCK
  TOPIC_WISE
  YEAR_WISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  parentOf     ParentChild[] @relation("parent")
  childOf      ParentChild[] @relation("child")
  mockTestAttempts MockTestAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ParentChild {
  id         String @id @default(cuid())
  parentId   String
  childId    String
  approved   Boolean @default(true)

  parent User @relation("parent", fields: [parentId], references: [id])
  child  User @relation("child", fields: [childId], references: [id])

  @@unique([parentId, childId])
}

model Subject {
  id       String   @id @default(cuid())
  name     String
  category String
  weightage Int
  createdAt DateTime @default(now())
    studyMaterials StudyMaterial[]
    mockTest MockTest[]
    
}

model StudyMaterial {
  id          String      @id @default(cuid())
  title       String
  type        ContentType
  fileUrl     String
  subjectId   String
  isPremium   Boolean     @default(false)
  downloads   Int         @default(0)
  uploadedBy  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
}

model MockTest {
  id          String   @id @default(cuid())
  title       String
  description String?
  subjectId   String?
  examType    ExamType @default(FULL_MOCK)
  year        Int?
  duration    Int
  accessCode  String   @unique
  isActive    Boolean  @default(false)
  totalMarks  Int
  questions   MockTestQuestion[]
  attempts    MockTestAttempt[]
  
  subject Subject? @relation(fields: [subjectId], references: [id])
}

model MockTestQuestion {
  id          String   @id @default(cuid())
  testId      String
  text        String
  options     String[]
  correctIndex Int
  marks       Int      @default(1)
  
  test MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model MockTestAttempt {
  id         String   @id @default(cuid())
  userId     String
  testId     String
  score      Int
  percentage Float
  completedAt DateTime @default(now())
  
  user User      @relation(fields: [userId], references: [id])
  test MockTest  @relation(fields: [testId], references: [id])
}
generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  

}

enum Role {
  STUDENT
  ADMIN
  PARENT
}

enum SubscriptionTier {
  NORMAL
  PREMIUM
  SUPER_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum ContentType {
  PYQ
  NOTE
}

enum ExamType {
  FULL_MOCK
  TOPIC_WISE
  YEAR_WISE
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  password      String?
  role          Role             @default(STUDENT)
  tier          SubscriptionTier @default(NORMAL)   // ← ADD THIS
  emailVerified DateTime?
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  accounts         Account[]
  sessions         Session[]
  parentOf         ParentChild[]      @relation("parent")
  childOf          ParentChild[]      @relation("child")
  mockTestAttempts MockTestAttempt[]
  subscription     Subscription?
   topicProgress    UserTopicProgress[]

}
model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  tier              SubscriptionTier
  status            SubscriptionStatus @default(ACTIVE)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int
  currency          String             @default("INR")
  startsAt          DateTime           @default(now())
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ParentChild {
  id         String @id @default(cuid())
  parentId   String
  childId    String
  approved   Boolean @default(true)

  parent User @relation("parent", fields: [parentId], references: [id])
  child  User @relation("child", fields: [childId], references: [id])

  @@unique([parentId, childId])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  category  String
  weightage Int
  createdAt DateTime @default(now())
  
  studyMaterials StudyMaterial[]
  mockTests      MockTest[]
  topics         Topic[]
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  subjectId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress UserTopicProgress[]
}

model UserTopicProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean  @default(false)
  completedAt DateTime?
  
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@unique([userId, topicId])
}

model StudyMaterial {
  id           String      @id @default(cuid())
  title        String
  type         ContentType
  fileUrl      String
  subjectId    String
  requiredTier SubscriptionTier @default(NORMAL)
  downloads    Int         @default(0)
  uploadedBy   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
}

model MockTest {
  id           String   @id @default(cuid())
  title        String
  description  String?
  subjectId    String?
  examType     ExamType @default(FULL_MOCK)
  year         Int?
  duration     Int
  accessCode   String   @unique
  isActive     Boolean  @default(false)
  totalMarks   Int
  requiredTier SubscriptionTier @default(NORMAL)
  questions    MockTestQuestion[]
  attempts     MockTestAttempt[]
  
  subject Subject? @relation(fields: [subjectId], references: [id])
}



model MockTestQuestion {
  id            String   @id @default(cuid())
  testId        String
  text          String
  textAs        String?
  imageUrl      String?
  options       String[]
  optionsAs     String[]
  correctIndex  Int
  marks         Int      @default(4)
  negativeMarks Float    @default(1)   // ← ADD
  section       String   @default("General")
  order         Int      @default(0)   // ← ADD

  test MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// Update MockTestAttempt:
model MockTestAttempt {
  id          String    @id @default(cuid())
  userId      String
  testId      String
  score       Int       @default(0)
  percentage  Float     @default(0)
  answers     Json?     // ← ADD
  status      String    @default("IN_PROGRESS")  // ← ADD
  startedAt   DateTime  @default(now())
  completedAt DateTime? // ← ADD

  user User     @relation(fields: [userId], references: [id])
  test MockTest @relation(fields: [testId], references: [id])
}
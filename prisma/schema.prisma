// prisma/schema.prisma — complete evolved schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  PREMIUM_STUDENT // ← replaces NORMAL tier concept
  ADMIN
  SUPER_ADMIN // ← new, only manages admins
}

enum BatchType {
  CEE_PREP // ← your existing content maps here
  BTECH
  COMPETITIVE
  FREE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING // for free batch lead-form pending approval
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ContentType {
  PYQ
  NOTE
}

enum ExamType {
  FULL_MOCK
  TOPIC_WISE
  YEAR_WISE
}

// ─── Auth (keep as-is) ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  image         String?
  suspended     Boolean   @default(false)
  deletedAt     DateTime? // soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  enrollments      Enrollment[]
  mockTestAttempts MockTestAttempt[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]          @relation("AuditActor")
  certificates     Certificate[]
  leadSubmissions  LeadSubmission[]
  topicProgress    UserTopicProgress[] // ← ADD THIS
  subscription     Subscription?

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Content Structure ────────────────────────────────────────────────────────

// Engineering branches (CSE, ECE, ME etc.) — new for B.Tech
model Branch {
  id       String    @id @default(cuid())
  name     String // "Computer Science & Engineering"
  code     String    @unique // "CSE"
  subjects Subject[]
  batches  Batch[]
}

// Semesters 1–8
model Semester {
  id       Int       @id // 1-8
  subjects Subject[]
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  code       String?
  category   String
  weightage  Int     @default(0)
  branchId   String?
  semesterId Int?

  branch    Branch?         @relation(fields: [branchId], references: [id])
  semester  Semester?       @relation(fields: [semesterId], references: [id])
  topics    Topic[]
  materials StudyMaterial[] // ← REPLACED notes + pyqs
  tests     MockTest[]

  @@index([branchId])
}

model Topic {
  id        String              @id @default(cuid())
  name      String
  subjectId String
  order     Int                 @default(0)
  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress  UserTopicProgress[]
}

model UserTopicProgress {
  id          String    @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

// ─── Batch System (main new feature) ─────────────────────────────────────────

model Batch {
  id            String    @id @default(cuid())
  name          String // "Sarathi", "Sankalpa"
  slug          String    @unique
  tagline       String?
  description   String?
  type          BatchType @default(CEE_PREP)
  isFree        Boolean   @default(false)
  price         Int       @default(0) // paise
  originalPrice Int? // for showing strikethrough
  badge         String? // "Most Popular", "New", "Bestseller"
  bannerUrl     String? // Cloudinary
  iconUrl       String?
  validDays     Int? // null = lifetime
  isActive      Boolean   @default(true)
  isPublished   Boolean   @default(false)
  sortOrder     Int       @default(0)
  branchId      String?
  deletedAt     DateTime? // soft delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch      Branch?        @relation(fields: [branchId], references: [id])
  features    BatchFeature[]
  tests       BatchTest[]
  notes       BatchNote[]
  pyqs        BatchPYQ[]
  enrollments Enrollment[]
  leadForm    LeadForm?
  coupons     Coupon[]

  @@index([slug])
  @@index([isActive, isPublished])
  @@index([type])
}

model BatchFeature {
  id      String  @id @default(cuid())
  batchId String
  text    String
  icon    String? // lucide icon name
  order   Int     @default(0)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// Junction: which tests belong to which batch
model BatchTest {
  id      String   @id @default(cuid())
  batchId String
  testId  String
  order   Int      @default(0)
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  test    MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([batchId, testId])
}

model BatchNote {
  id      String        @id @default(cuid())
  batchId String
  noteId  String
  order   Int           @default(0)
  batch   Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  note    StudyMaterial @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([batchId, noteId])
}

model BatchPYQ {
  id      String        @id @default(cuid())
  batchId String
  pyqId   String
  order   Int           @default(0)
  batch   Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pyq     StudyMaterial @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@unique([batchId, pyqId])
}

// ─── Enrollment ───────────────────────────────────────────────────────────────

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  batchId   String
  status    EnrollmentStatus @default(ACTIVE)
  source    String? // "payment" | "coupon" | "admin_grant" | "lead_form"
  expiresAt DateTime?
  grantedBy String? // admin userId if manually granted
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  batch   Batch    @relation(fields: [batchId], references: [id])
  payment Payment? // if purchased

  @@unique([userId, batchId])
  @@index([userId])
  @@index([batchId])
  @@index([status])
}

// ─── Lead Forms (free batch registration) ─────────────────────────────────────

model LeadForm {
  id          String          @id @default(cuid())
  batchId     String          @unique
  title       String          @default("Register for Free")
  description String?
  fields      LeadFormField[]
  batch       Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model LeadFormField {
  id          String   @id @default(cuid())
  formId      String
  label       String // "Full Name"
  placeholder String?
  fieldType   String // "text" | "email" | "phone" | "select" | "textarea"
  required    Boolean  @default(true)
  order       Int
  options     String[] // for select fields: ["Guwahati", "Jorhat", ...]
  form        LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model LeadSubmission {
  id        String   @id @default(cuid())
  batchId   String
  userId    String?
  data      Json // { "Full Name": "Rahul Das", "Phone": "9876..." }
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([batchId])
}

// ─── Content ──────────────────────────────────────────────────────────────────

model StudyMaterial {
  id           String      @id @default(cuid())
  title        String
  type         ContentType
  fileUrl      String
  subjectId    String?
  year         Int?
  requiredTier String      @default("NORMAL")
  downloads    Int         @default(0)
  uploadedBy   String
  status       String      @default("published")
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  subject   Subject?    @relation(fields: [subjectId], references: [id]) // ← REMOVED "SubjectNotes"
  batchNote BatchNote[]
  batchPYQ  BatchPYQ[]

  @@index([type])
  @@index([status])
}

// ─── Mock Tests ───────────────────────────────────────────────────────────────

model MockTest {
  id           String    @id @default(cuid())
  title        String
  description  String?
  subjectId    String?
  examType     ExamType  @default(FULL_MOCK)
  year         Int?
  duration     Int // minutes
  accessCode   String    @unique
  isActive     Boolean   @default(false)
  totalMarks   Int
  requiredTier String    @default("NORMAL") // ✅ ADD THIS
  scheduledAt  DateTime?
  endsAt       DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  subject    Subject?           @relation(fields: [subjectId], references: [id])
  questions  MockTestQuestion[]
  attempts   MockTestAttempt[]
  batchTests BatchTest[]

  @@index([isActive])
}

model MockTestQuestion {
  id                  String   @id @default(cuid())
  testId              String
  text                String
  textAs              String?
  imageUrl            String?
  options             String[]
  optionsAs           String[]
  correctIndex        Int
  marks               Int      @default(4)
  negativeMarks       Float    @default(1)
  section             String   @default("General")
  order               Int      @default(0)
  explanation         String? // admin-written solution text
  explanationImageUrl String?

  test MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model MockTestAttempt {
  id              String    @id @default(cuid())
  userId          String
  testId          String
  score           Int       @default(0)
  percentage      Float     @default(0)
  answers         Json?
  status          String    @default("IN_PROGRESS")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id])
  test            MockTest  @relation(fields: [testId], references: [id])
  markedForReview String[]  @default([])

  @@index([userId])
  @@index([testId])
  @@index([status])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  userId            String
  batchId           String?
  enrollmentId      String?       @unique
  amount            Int // paise
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  couponId          String?
  discountAmount    Int?
  invoiceUrl        String?
  refundId          String?
  refundedAt        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  discount    Int // percentage 0-100
  maxUses     Int       @default(100)
  used        Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  batchId     String? // null = all batches
  createdAt   DateTime  @default(now())

  batch    Batch?    @relation(fields: [batchId], references: [id])
  payments Payment[]

  @@index([code])
  @@index([isActive])
}

// ─── Certificates ─────────────────────────────────────────────────────────────

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  batchId  String?
  testId   String?
  title    String
  fileUrl  String?
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | PAYMENT
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // "ROLE_CHANGED", "BATCH_CREATED", "USER_SUSPENDED"
  entity    String // "User", "Batch", "Payment"
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Platform Settings ────────────────────────────────────────────────────────

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique // "platform_name", "maintenance_mode", etc.
  value     Json
  updatedAt DateTime @updatedAt
}

// Backward compat — keep Subscription for existing CEE users
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  tier              String
  status            String   @default("ACTIVE")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int
  currency          String   @default("INR")
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

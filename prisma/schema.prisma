generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String?
  password         String?
  role             Role                @default(STUDENT)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  suspended        Boolean             @default(false)
  deletedAt        DateTime?
  district         String?
  phone            String?
  school           String?
  hasAnalytics     Boolean             @default(false)
  hasCounselling   Boolean             @default(false)
  hasPredictor     Boolean             @default(false)
  squadId          String?
  accounts         Account[]
  auditLogs        AuditLog[]          @relation("AuditActor")
  certificates     Certificate[]
  enrollments      Enrollment[]
  leadSubmissions  LeadSubmission[]
  mockTestAttempts MockTestAttempt[]
  notifications    Notification[]
  payments         Payment[]
  sessions         Session[]
  subscription     Subscription?
  squad            Squad?              @relation(fields: [squadId], references: [id])
  topicProgress    UserTopicProgress[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([squadId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Branch {
  id       String    @id @default(cuid())
  name     String
  code     String    @unique
  batches  Batch[]
  subjects Subject[]
}

model Semester {
  id       Int       @id
  subjects Subject[]
}

model Subject {
  id         String          @id @default(cuid())
  name       String
  category   String
  weightage  Int             @default(0)
  branchId   String?
  code       String?
  semesterId Int?
  tests      MockTest[]
  materials  StudyMaterial[]
  branch     Branch?         @relation(fields: [branchId], references: [id])
  semester   Semester?       @relation(fields: [semesterId], references: [id])
  topics     Topic[]

  @@index([branchId])
}

model Topic {
  id        String              @id @default(cuid())
  name      String
  subjectId String
  order     Int                 @default(0)
  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress  UserTopicProgress[]
}

model UserTopicProgress {
  id          String    @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean   @default(false)
  completedAt DateTime?
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model Batch {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  tagline       String?
  description   String?
  type          BatchType      @default(CEE_PREP)
  isFree        Boolean        @default(false)
  price         Int            @default(0)
  originalPrice Int?
  badge         String?
  bannerUrl     String?
  iconUrl       String?
  validDays     Int?
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(false)
  sortOrder     Int            @default(0)
  branchId      String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch?        @relation(fields: [branchId], references: [id])
  features      BatchFeature[]
  notes         BatchNote[]
  pyqs          BatchPYQ[]
  tests         BatchTest[]
  coupons       Coupon[]
  enrollments   Enrollment[]
  leadForm      LeadForm?

  @@index([slug])
  @@index([isActive, isPublished])
  @@index([type])
}

model BatchFeature {
  id      String  @id @default(cuid())
  batchId String
  text    String
  icon    String?
  order   Int     @default(0)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model BatchTest {
  id      String   @id @default(cuid())
  batchId String
  testId  String
  order   Int      @default(0)
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  test    MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([batchId, testId])
}

model BatchNote {
  id      String        @id @default(cuid())
  batchId String
  noteId  String
  order   Int           @default(0)
  batch   Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  note    StudyMaterial @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([batchId, noteId])
}

model BatchPYQ {
  id      String        @id @default(cuid())
  batchId String
  pyqId   String
  order   Int           @default(0)
  batch   Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pyq     StudyMaterial @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  @@unique([batchId, pyqId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  batchId   String
  status    EnrollmentStatus @default(ACTIVE)
  source    String?
  expiresAt DateTime?
  grantedBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  batch     Batch            @relation(fields: [batchId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  payment   Payment?

  @@unique([userId, batchId])
  @@index([userId])
  @@index([batchId])
  @@index([status])
}

model LeadForm {
  id          String          @id @default(cuid())
  batchId     String          @unique
  title       String          @default("Register for Free")
  description String?
  batch       Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fields      LeadFormField[]
}

model LeadFormField {
  id          String   @id @default(cuid())
  formId      String
  label       String
  placeholder String?
  fieldType   String
  required    Boolean  @default(true)
  order       Int
  options     String[]
  form        LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model LeadSubmission {
  id        String   @id @default(cuid())
  batchId   String
  userId    String?
  data      Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([batchId])
}

model StudyMaterial {
  id           String      @id @default(cuid())
  title        String
  type         ContentType
  fileUrl      String
  subjectId    String?
  downloads    Int         @default(0)
  uploadedBy   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  status       String      @default("published")
  year         Int?
  deletedAt    DateTime?
  requiredTier String      @default("NORMAL")
  batchNote    BatchNote[]
  batchPYQ     BatchPYQ[]
  subject      Subject?    @relation(fields: [subjectId], references: [id])

  @@index([type])
  @@index([status])
}

model MockTest {
  id           String             @id @default(cuid())
  title        String
  description  String?
  subjectId    String?
  examType     ExamType           @default(FULL_MOCK)
  year         Int?
  duration     Int
  accessCode   String             @unique
  isActive     Boolean            @default(false)
  totalMarks   Int
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?
  endsAt       DateTime?
  scheduledAt  DateTime?
  requiredTier String             @default("NORMAL")
  folderId     String?
  folder       MockTestFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  batchTests   BatchTest[]
  subject      Subject?           @relation(fields: [subjectId], references: [id])
  attempts     MockTestAttempt[]
  questions    MockTestQuestion[]

  @@index([isActive])
}

model MockTestFolder {
  id          String     @id @default(cuid())
  name        String
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tests       MockTest[]
}

model MockTestQuestion {
  id                  String   @id @default(cuid())
  testId              String
  text                String
  options             String[]
  correctIndex        Int
  marks               Int      @default(4)
  imageUrl            String?
  negativeMarks       Float    @default(1)
  optionsAs           String[]
  order               Int      @default(0)
  section             String   @default("General")
  textAs              String?
  explanation         String?
  explanationImageUrl String?
  optionImages        String[] @default([])
  test                MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model MockTestAttempt {
  id              String    @id @default(cuid())
  userId          String
  testId          String
  score           Int       @default(0)
  percentage      Float     @default(0)
  completedAt     DateTime?
  answers         Json?
  startedAt       DateTime  @default(now())
  status          String    @default("IN_PROGRESS")
  markedForReview String[]  @default([])
  test            MockTest  @relation(fields: [testId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([testId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  batchId           String?
  enrollmentId      String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?
  couponId          String?
  discountAmount    Int?
  invoiceUrl        String?
  refundId          String?
  refundedAt        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  serviceType       String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  enrollment        Enrollment?   @relation(fields: [enrollmentId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  discount    Int
  maxUses     Int       @default(100)
  used        Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  batchId     String?
  createdAt   DateTime  @default(now())
  batch       Batch?    @relation(fields: [batchId], references: [id])
  payments    Payment[]

  @@index([code])
  @@index([isActive])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  batchId  String?
  testId   String?
  title    String
  fileUrl  String?
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Int
  currency          String   @default("INR")
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tier              String
  status            String   @default("ACTIVE")
  user              User     @relation(fields: [userId], references: [id])
}

model Squad {
  id           String   @id @default(cuid())
  name         String
  inviteCode   String   @unique
  goalTarget   Int      @default(500)
  currentScore Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      User[]
}

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String?
  type      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cutoffs   Cutoff[]
}

model Cutoff {
  id          String   @id @default(cuid())
  collegeId   String
  branchName  String
  category    String
  year        Int
  round       Int?
  closingRank Int
  openingRank Int?
  cutoffMarks Int? // NEW — marks of last admitted candidate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([category])
  @@index([closingRank])
}

enum Role {
  STUDENT
  PREMIUM_STUDENT
  ADMIN
  SUPER_ADMIN
}

enum BatchType {
  CEE_PREP
  BTECH
  COMPETITIVE
  FREE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ContentType {
  PYQ
  NOTE
}

enum ExamType {
  FULL_MOCK
  TOPIC_WISE
  YEAR_WISE
}
